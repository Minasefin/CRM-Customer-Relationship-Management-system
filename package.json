{
  "name": "contractor-crm",
  "productName": "Contractor CRM",
  "version": "0.1.0",
  "private": true,
  "description": "Secure offline desktop CRM for managing military contractors and the firms that employ them.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,app \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "test:db": "npm rebuild better-sqlite3-multiple-ciphers && node --test database/database.test.cjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "26.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.7",
    "wait-on": "^8.0.1"
  },
  "author": "Mina, Adrian and Nic"
}
