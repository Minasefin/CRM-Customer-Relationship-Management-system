{
  "name": "contractor-crm",
  "productName": "Contractor CRM",
  "version": "0.1.0",
  "private": true,
  "description": "Secure offline desktop CRM for managing military contractors and the firms that employ them.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,app \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  }
}
